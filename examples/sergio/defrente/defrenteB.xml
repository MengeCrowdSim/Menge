<?xml version="1.0"?>

<BFSM>
	<GoalSet id="0">
		<Goal type="point" id="1" x="10" y="-0.1" />
		<Goal type="point" id="2" x="-10" y="-0.1" />	</GoalSet>
	
		<State name="Walk1" final="0" >
			<GoalSelector type="explicit" goal_set="0" goal="2" per_agent="1" />
			<VelComponent type="goal" weight="1.0" />
		</State>
		<State name="Walk2" final="0" >
			<GoalSelector type="explicit" goal_set="0" goal="1" per_agent="1" />
			<VelComponent type="goal" weight="1.0" />
		</State>
		<State name="Stop" final="1" >
			<GoalSelector type="explicit" goal_set="0" goal="1" per_agent="1" />
			<VelComponent type="zero" />
		</State>
		
 
        <Transition from="Walk1,Walk2" to="Stop" >
            <Condition type="goal_reached" distance=".25" />
        </Transition>
</BFSM>